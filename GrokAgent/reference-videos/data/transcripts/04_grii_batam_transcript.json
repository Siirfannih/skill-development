  "transcript": "yang namanya londo irng itu kayak begitu sudah kalau jadi pecahbat pegang kuasa bisa ngatur undang-undang bisa eksekusi bisa pake aparat penegang ukung untuk pencet orang pake pacak bikin perijinan tetanggutan rampas tanah adat setelah itu kalau ada banjir kita mesti tabah terdemusi bah dari mengkuasa sudah kurang londo apa ini sudah ya persis kayak pada waktu itu ya sabat itu perintah yang diberikan oleh Tuhan untuk membebasikan orang-orang yang sangat lemah perintahnya anjelas ya jangan kamu bekerja pada hari sabat orang-orang lemah orang-orang dibawah yang disuruh kerja paksa dikasih perintah sabat sabat adalah perintah untuk orang-orang dibawah bisa istirahat sabat itu perintah pembebasan tapi sekarang sudah dilengkungkan orang-orang agami seperti ini sudah sabat itu menjadi semacam kayak peraturan agama dan semakin beragama mereka semakin bersabat mereka semakin tinggi nilainya padahal sabat itu adalah untuk orang-orang yang dibawah sabat dibalik sudah prinsipnya harika merdekaan dengan sabat sebenarnya mirip ya sudah membebaskan orang-orang yang tertindas sudah kita waktu ngomong tentang KOMPERDECAAN sudah bersiap-siap untuk mendengarkan kekonyalan-kekonyalan yang kita tonton dengan bayar tiket tiketnya adalah darah dan air matanya orang-orang melarat bidatuh-bidatuh ada angka-angka yang super fantasi lalu nanti akan mendapatkan tepuk tangan yang banyak dari pejilat-pejilat yang berharap cabatan saja dapat cabatan atau mempertahankan cabatan atau naik cabatan atau rangkap cabatan ya kurang lebih seperti itu ongkosnya ya darah dan air matanya orang-orang kecil kita diajak untuk nasionalis mencintai negara untuk mumpa cara juga lalu melakukan kejutan-kejutan yang minim sekali vaidah kalau karung makan kerubu bagianya dipasangin juga itu kemerdekaan juga yang merdekas ya apa sih sabat dipake dia eksploitasi oleh para pemimpin agamanya yusus-yusus membalikkan itu maka yusus datang untuk membebaskan dan ongkosnya adalah dia menjadi kurban mati dia terserah-serah",
  "segments": [
    {
      "start": 0.0,
      "end": 1.64,
      "text": "yang namanya londo irng itu kayak begitu sudah"
    },
    {
      "start": 1.64,
      "end": 3.04,
      "text": "kalau jadi pecahbat"
    },
    {
      "start": 3.04,
      "end": 4.06,
      "text": "pegang kuasa"
    },
    {
      "start": 4.06,
      "end": 5.4,
      "text": "bisa ngatur undang-undang"
    },
    {
      "start": 5.4,
      "end": 6.46,
      "text": "bisa eksekusi"
    },
    {
      "start": 6.46,
      "end": 8.08,
      "text": "bisa pake aparat penegang ukung"
    },
    {
      "start": 8.08,
      "end": 9.92,
      "text": "untuk pencet orang pake pacak"
    },
    {
      "start": 9.92,
      "end": 10.88,
      "text": "bikin perijinan"
    },
    {
      "start": 10.88,
      "end": 11.54,
      "text": "tetanggutan"
    },
    {
      "start": 11.54,
      "end": 12.78,
      "text": "rampas tanah adat"
    },
    {
      "start": 12.78,
      "end": 14.06,
      "text": "setelah itu kalau ada banjir"
    },
    {
      "start": 14.06,
      "end": 17.24,
      "text": "kita mesti tabah terdemusi bah dari mengkuasa sudah"
    },
    {
      "start": 17.24,
      "end": 18.72,
      "text": "kurang londo apa ini sudah ya"
    },
    {
      "start": 18.72,
      "end": 20.0,
      "text": "persis kayak pada waktu itu ya"
    },
    {
      "start": 20.0,
      "end": 22.02,
      "text": "sabat itu perintah yang diberikan oleh Tuhan"
    },
    {
      "start": 22.02,
      "end": 23.44,
      "text": "untuk membebasikan orang-orang yang sangat lemah"
    },
    {
      "start": 23.44,
      "end": 24.58,
      "text": "perintahnya anjelas ya"
    },
    {
      "start": 24.58,
      "end": 26.34,
      "text": "jangan kamu bekerja pada hari sabat"
    },
    {
      "start": 26.88,
      "end": 27.68,
      "text": "orang-orang lemah"
    },
    {
      "start": 27.68,
      "end": 29.3,
      "text": "orang-orang dibawah yang disuruh kerja paksa"
    },
    {
      "start": 29.3,
      "end": 30.62,
      "text": "dikasih perintah sabat"
    },
    {
      "start": 30.62,
      "end": 33.0,
      "text": "sabat adalah perintah untuk orang-orang dibawah"
    },
    {
      "start": 33.0,
      "end": 33.82,
      "text": "bisa istirahat"
    },
    {
      "start": 33.82,
      "end": 36.04,
      "text": "sabat itu perintah pembebasan"
    },
    {
      "start": 36.04,
      "end": 38.84,
      "text": "tapi sekarang sudah dilengkungkan orang-orang agami seperti ini sudah"
    },
    {
      "start": 38.84,
      "end": 41.44,
      "text": "sabat itu menjadi semacam kayak peraturan agama"
    },
    {
      "start": 41.44,
      "end": 43.12,
      "text": "dan semakin beragama mereka"
    },
    {
      "start": 43.12,
      "end": 44.46,
      "text": "semakin bersabat mereka"
    },
    {
      "start": 44.46,
      "end": 45.86,
      "text": "semakin tinggi nilainya"
    },
    {
      "start": 45.86,
      "end": 47.82,
      "text": "padahal sabat itu adalah untuk orang-orang yang dibawah"
    },
    {
      "start": 47.82,
      "end": 49.44,
      "text": "sabat dibalik sudah"
    },
    {
      "start": 49.44,
      "end": 51.62,
      "text": "prinsipnya harika merdekaan dengan sabat"
    },
    {
      "start": 51.62,
      "end": 52.42,
      "text": "sebenarnya mirip ya sudah"
    },
    {
      "start": 52.42,
      "end": 54.48,
      "text": "membebaskan orang-orang yang tertindas sudah"
    },
    {
      "start": 54.48,
      "end": 55.58,
      "text": "kita waktu ngomong tentang"
    },
    {
      "start": 55.58,
      "end": 56.58,
      "text": "KOMPERDECAAN"
    },
    {
      "start": 56.58,
      "end": 59.32,
      "text": "sudah bersiap-siap untuk mendengarkan kekonyalan-kekonyalan"
    },
    {
      "start": 59.32,
      "end": 61.18,
      "text": "yang kita tonton dengan bayar tiket"
    },
    {
      "start": 61.18,
      "end": 62.8,
      "text": "tiketnya adalah darah"
    },
    {
      "start": 62.8,
      "end": 64.64,
      "text": "dan air matanya orang-orang melarat"
    },
    {
      "start": 64.64,
      "end": 65.98,
      "text": "bidatuh-bidatuh"
    },
    {
      "start": 65.98,
      "end": 68.28,
      "text": "ada angka-angka yang super fantasi"
    },
    {
      "start": 68.28,
      "end": 70.28,
      "text": "lalu nanti akan mendapatkan tepuk tangan yang banyak"
    },
    {
      "start": 70.28,
      "end": 71.46,
      "text": "dari pejilat-pejilat yang"
    },
    {
      "start": 71.46,
      "end": 72.64,
      "text": "berharap cabatan saja"
    },
    {
      "start": 72.64,
      "end": 75.06,
      "text": "dapat cabatan atau mempertahankan cabatan"
    },
    {
      "start": 75.06,
      "end": 76.94,
      "text": "atau naik cabatan atau rangkap cabatan"
    },
    {
      "start": 76.94,
      "end": 77.74,
      "text": "ya kurang lebih seperti itu"
    },
    {
      "start": 77.74,
      "end": 78.8,
      "text": "ongkosnya ya"
    },
    {
      "start": 78.8,
      "end": 80.94,
      "text": "darah dan air matanya orang-orang kecil"
    },
    {
      "start": 80.94,
      "end": 82.8,
      "text": "kita diajak untuk nasionalis"
    },
    {
      "start": 82.8,
      "end": 83.96,
      "text": "mencintai negara"
    },
    {
      "start": 83.96,
      "end": 85.34,
      "text": "untuk mumpa cara juga"
    },
    {
      "start": 85.34,
      "end": 86.82,
      "text": "lalu melakukan kejutan-kejutan"
    },
    {
      "start": 86.82,
      "end": 88.32,
      "text": "yang minim sekali vaidah"
    },
    {
      "start": 88.32,
      "end": 89.98,
      "text": "kalau karung makan kerubu"
    },
    {
      "start": 89.98,
      "end": 91.0,
      "text": "bagianya dipasangin juga"
    },
    {
      "start": 91.0,
      "end": 92.22,
      "text": "itu kemerdekaan juga"
    },
    {
      "start": 92.22,
      "end": 93.48,
      "text": "yang merdekas ya apa sih"
    },
    {
      "start": 93.48,
      "end": 94.62,
      "text": "sabat dipake"
    },
    {
      "start": 94.62,
      "end": 96.82,
      "text": "dia eksploitasi oleh para pemimpin agamanya"
    },
    {
      "start": 96.82,
      "end": 98.02,
      "text": "yusus-yusus membalikkan itu"
    },
    {
      "start": 98.02,
      "end": 99.72,
      "text": "maka yusus datang untuk membebaskan"
    },
    {
      "start": 99.72,
      "end": 102.82,
      "text": "dan ongkosnya adalah dia menjadi kurban"
    },
    {
      "start": 102.82,
      "end": 105.0,
      "text": "mati dia terserah-serah"
    }
