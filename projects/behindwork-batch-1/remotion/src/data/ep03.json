 "sub": [
  {
   "dari": 0.0,
   "sampai": 3.76,
   "teks": "Ini video pertama YouTube,<br>19 detik dan dua gajah,"
  },
  {
   "dari": 3.76,
   "sampai": 9.007,
   "teks": "dan detik demi detik, video ini<br>bercerita bagaimana YouTube dimulai."
  },
  {
   "dari": 9.007,
   "sampai": 14.654,
   "teks": "Detik 0. Tanggal 23 April 2005,<br>di Kebun Binatang San Diego."
  },
  {
   "dari": 14.654,
   "sampai": 17.72,
   "teks": "Detik 2. Itu Jawed Karim, pendiri ketiga,"
  },
  {
   "dari": 17.72,
   "sampai": 22.221,
   "teks": "bareng Chad Hurley dan Steve Chen,<br>semuanya dari PayPal."
  },
  {
   "dari": 22.221,
   "sampai": 28.7,
   "teks": "Detik 4. Kejutannya: situs ini dimulai<br>di Hari Valentine sebagai situs kencan,"
  },
  {
   "dari": 28.7,
   "sampai": 32.309,
   "teks": "dan kata Karim, slogannya:<br>Tune in, Hook up."
  },
  {
   "dari": 32.309,
   "sampai": 35.34,
   "teks": "Detik 7. Jelas, gajah bukan calon pacar,"
  },
  {
   "dari": 35.34,
   "sampai": 40.84,
   "teks": "dan kata Karim, situsnya sepi sekali,<br>sampai dia pasang iklan di Craigslist,"
  },
  {
   "dari": 40.84,
   "sampai": 44.219,
   "teks": "20 dolar per video,<br>dan yang membalas: nol."
  },
  {
   "dari": 44.219,
   "sampai": 53.52,
   "teks": "Detik 12. Tapi orang mengunggah apa saja,<br>anjing, liburan, gajah,"
  },
  {
   "dari": 53.52,
   "sampai": 53.879,
   "teks": "jadi situsnya dibuka untuk semua video."
  },
  {
   "dari": 53.879,
   "sampai": 56.82,
   "teks": "Detik 15. Cerita pesta makan malam<br>yang terkenal itu?"
  },
  {
   "dari": 56.82,
   "sampai": 60.56,
   "teks": "Karim bilang ke majalah Time,<br>pesta itu nggak pernah ada,"
  },
  {
   "dari": 60.56,
   "sampai": 63.239,
   "teks": "dan Chen mengakui<br>ceritanya dibumbui pemasaran."
  },
  {
   "dari": 63.239,
   "sampai": 65.76,
   "teks": "Detik 17. Versi Karim sendiri:"
  },
  {
   "dari": 65.76,
   "sampai": 71.149,
   "teks": "idenya lahir dari video<br>tsunami 2004 di Indonesia."
  },
  {
   "dari": 71.149,
   "sampai": 73.26,
   "teks": "Detik 19, videonya selesai,"
  },
  {
   "dari": 73.26,
   "sampai": 78.959,
   "teks": "dan Oktober 2006, Google membelinya<br>1,65 miliar dolar, dalam saham."
  },
  {
   "dari": 78.959,
   "sampai": 80.689,
   "teks": "Kami sudah diakuisisi Google."
  },
  {
   "dari": 80.689,
   "sampai": 81.58,
   "teks": "Rencananya untuk kencan,"
  },
  {
   "dari": 81.58,
   "sampai": 84.446,
   "teks": "tapi orang datang membawa<br>semua hal lainnya."
  },
  {
   "dari": 84.446,
   "sampai": 86.06,
   "teks": "Jadi rencana awalmu boleh salah,"
  },
  {
   "dari": 86.06,
   "sampai": 89.293,
   "teks": "asal cepat melihat<br>apa yang benar-benar dipakai orang."
  },
  {
   "dari": 89.293,
   "sampai": 92.903,
   "teks": "Detik ke berapa yang paling bikin kaget?<br>Tulis di komentar."
  }
 ],
