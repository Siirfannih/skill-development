 "sub": [
  {
   "dari": 0.0,
   "sampai": 2.22,
   "teks": "Jam 9 malam, di sebuah warnet,"
  },
  {
   "dari": 2.22,
   "sampai": 7.406,
   "teks": "pemuda yang berjaga ini<br>kelak mendirikan Tokopedia."
  },
  {
   "dari": 7.406,
   "sampai": 11.786,
   "teks": "Shift-nya dua belas jam,<br>sampai jam 9 pagi, setiap hari."
  },
  {
   "dari": 11.786,
   "sampai": 15.86,
   "teks": "Dia William Tanuwijaya,<br>dari Pematangsiantar,"
  },
  {
   "dari": 15.86,
   "sampai": 21.726,
   "teks": "yang tahun 1999 naik kapal ke Jakarta<br>untuk kuliah, empat hari tiga malam."
  },
  {
   "dari": 21.726,
   "sampai": 24.02,
   "teks": "Tapi di tahun kedua, ayahnya jatuh sakit,"
  },
  {
   "dari": 24.02,
   "sampai": 27.226,
   "teks": "dan William harus jadi<br>tulang punggung keluarga."
  },
  {
   "dari": 27.226,
   "sampai": 31.8,
   "teks": "Supaya tetap kuliah, dia jaga shift malam,<br>bonusnya internet gratis,"
  },
  {
   "dari": 31.8,
   "sampai": 35.246,
   "teks": "dan kata William, di situlah<br>dia jatuh cinta sama internet."
  },
  {
   "dari": 35.246,
   "sampai": 37.4,
   "teks": "Dia lulus tahun 2003,"
  },
  {
   "dari": 37.4,
   "sampai": 43.356,
   "teks": "dan tahun 2007 idenya datang:<br>pasar online yang bisa dipercaya."
  },
  {
   "dari": 43.356,
   "sampai": 46.206,
   "teks": "Lalu datanglah jam paling gelap."
  },
  {
   "dari": 46.206,
   "sampai": 48.4,
   "teks": "Dia nggak kenal satu pun investor,"
  },
  {
   "dari": 48.4,
   "sampai": 51.035,
   "teks": "dan dua tahun, semua tawarannya gagal."
  },
  {
   "dari": 51.035,
   "sampai": 56.38,
   "teks": "William ingat salah satunya bilang:"
  },
  {
   "dari": 56.38,
   "sampai": 56.625,
   "teks": "panutanmu lahir spesial, kamu nggak."
  },
  {
   "dari": 56.625,
   "sampai": 59.36,
   "teks": "Dia menyebutnya tamparan<br>yang bikin dia berani,"
  },
  {
   "dari": 59.36,
   "sampai": 60.685,
   "teks": "jadi dia jalan terus."
  },
  {
   "dari": 60.685,
   "sampai": 63.68,
   "teks": "17 Agustus 2009, shift itu selesai,"
  },
  {
   "dari": 63.68,
   "sampai": 68.855,
   "teks": "dan Tokopedia diluncurkan,<br>bersama Leontinus Alpha Edison."
  },
  {
   "dari": 68.855,
   "sampai": 73.34,
   "teks": "Tahun 2021, Tokopedia bergabung<br>dengan Gojek jadi GoTo,"
  },
  {
   "dari": 73.34,
   "sampai": 77.725,
   "teks": "lumayan, untuk orang yang menyebut<br>dirinya lulusan warnet."
  },
  {
   "dari": 77.725,
   "sampai": 80.46,
   "teks": "Jadi mungkin investor menilai rekam jejak,"
  },
  {
   "dari": 80.46,
   "sampai": 84.285,
   "teks": "dan kalau belum punya, ya bangun sendiri,<br>satu shift demi satu shift."
  },
  {
   "dari": 84.285,
   "sampai": 88.228,
   "teks": "Shift malammu sekarang di jam berapa?<br>Tulis di komentar."
  }
