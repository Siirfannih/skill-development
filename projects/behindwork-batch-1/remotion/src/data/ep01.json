 "sub": [
  {
   "dari": 0.0,
   "sampai": 2.02,
   "teks": "Mungkin kamu pernah dengar cerita ini:"
  },
  {
   "dari": 2.02,
   "sampai": 6.74,
   "teks": "sebelum bikin NVIDIA, Jensen Huang<br>katanya kerja jadi tukang cuci mobil."
  },
  {
   "dari": 6.74,
   "sampai": 9.69,
   "teks": "Ceritanya enak didengar,<br>tapi bukan begitu kejadiannya."
  },
  {
   "dari": 9.69,
   "sampai": 13.51,
   "teks": "Yang sebenarnya terjadi<br>di balik jaket kulit itu jauh lebih berat."
  },
  {
   "dari": 13.51,
   "sampai": 18.41,
   "teks": "Untuk melihatnya,<br>kita harus mundur jauh, ke tahun 1972."
  },
  {
   "dari": 18.41,
   "sampai": 20.42,
   "teks": "Waktu itu Jensen baru sembilan tahun."
  },
  {
   "dari": 20.42,
   "sampai": 25.28,
   "teks": "Pamannya mengirimnya ke sekolah asrama<br>di Kentucky, dikira sekolah bergengsi,"
  },
  {
   "dari": 25.28,
   "sampai": 27.703,
   "teks": "ternyata sekolah asrama yang keras."
  },
  {
   "dari": 27.703,
   "sampai": 32.86,
   "teks": "Tugas hariannya di sana? Bersihin toilet<br>untuk sekitar seratus anak laki-laki."
  },
  {
   "dari": 32.86,
   "sampai": 35.273,
   "teks": "Dan teman sekamarnya remaja 17 tahun."
  },
  {
   "dari": 35.273,
   "sampai": 36.64,
   "teks": "Dulu aku membersihkan toilet."
  },
  {
   "dari": 36.64,
   "sampai": 40.143,
   "teks": "Aku sudah membersihkan lebih banyak toilet<br>daripada kalian semua."
  },
  {
   "dari": 40.143,
   "sampai": 44.26,
   "teks": "Umur 15, dia dapat kerja pertamanya<br>di Denny's, Portland."
  },
  {
   "dari": 44.26,
   "sampai": 49.078,
   "teks": "Bukan cuci mobil, tapi cuci piring,<br>lalu jadi busboy, lalu pelayan."
  },
  {
   "dari": 49.078,
   "sampai": 52.578,
   "teks": "Mungkin aku pencuci piring<br>terbaik di Denny's."
  },
  {
   "dari": 52.578,
   "sampai": 54.46,
   "teks": "Tapi dia nggak berhenti di dapur.<br>Dia kuliah teknik elektro,"
  },
  {
   "dari": 54.46,
   "sampai": 61.918,
   "teks": "lalu sembilan tahun merancang chip<br>di AMD dan LSI Logic."
  },
  {
   "dari": 61.918,
   "sampai": 71.0,
   "teks": "Sampai akhirnya, tahun 1993,<br>di sebuah booth Denny's di San Jose,"
  },
  {
   "dari": 71.0,
   "sampai": 71.748,
   "teks": "dia dan dua rekannya duduk<br>merancang satu perusahaan: NVIDIA."
  },
  {
   "dari": 71.748,
   "sampai": 74.36,
   "teks": "Dari bersihin toilet asrama<br>dan cuci piring,"
  },
  {
   "dari": 74.36,
   "sampai": 78.288,
   "teks": "sampai membangun perusahaan chip<br>paling bernilai di dunia."
  },
  {
   "dari": 78.288,
   "sampai": 82.34,
   "teks": "Jadi mungkin pelajarannya begini:<br>nggak ada pekerjaan yang terlalu rendah,"
  },
  {
   "dari": 82.34,
   "sampai": 85.108,
   "teks": "kalau kamu sedang membangun<br>kebiasaan yang membawamu ke puncak."
  },
  {
   "dari": 85.108,
   "sampai": 88.778,
   "teks": "Kalau kamu, kerja pertamamu dulu apa?<br>Cerita di komentar ya."
  }
 ],
