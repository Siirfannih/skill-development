 "sub": [
  {
   "dari": 0.0,
   "sampai": 1.28,
   "teks": "Dua game ini gagal total,"
  },
  {
   "dari": 1.28,
   "sampai": 4.997,
   "teks": "tapi dari keduanya lahir Flickr dan Slack."
  },
  {
   "dari": 4.997,
   "sampai": 8.24,
   "teks": "Pembuatnya sama, Stewart Butterfield,"
  },
  {
   "dari": 8.24,
   "sampai": 9.887,
   "teks": "dan polanya pun sama."
  },
  {
   "dari": 9.887,
   "sampai": 16.407,
   "teks": "Game pertamanya Game Neverending,<br>tahun 2002, game online di browser."
  },
  {
   "dari": 16.407,
   "sampai": 22.027,
   "teks": "Game keduanya Glitch, mulai 2009,<br>juga game online di browser."
  },
  {
   "dari": 22.027,
   "sampai": 26.067,
   "teks": "Game pertama kena krisis dotcom,<br>dan uangnya menipis."
  },
  {
   "dari": 26.067,
   "sampai": 27.82,
   "teks": "Game kedua kekurangan pemain,"
  },
  {
   "dari": 27.82,
   "sampai": 30.767,
   "teks": "dan Tiny Speck sendiri yang mengakuinya."
  },
  {
   "dari": 30.767,
   "sampai": 33.7,
   "teks": "November 2012, Glitch mengumumkan tutup,"
  },
  {
   "dari": 33.7,
   "sampai": 38.487,
   "teks": "dan TechCrunch melaporkan sekitar 30 orang<br>kehilangan pekerjaan."
  },
  {
   "dari": 38.487,
   "sampai": 40.52,
   "teks": "Catatan perpisahannya jujur, bunyinya:"
  },
  {
   "dari": 40.52,
   "sampai": 44.957,
   "teks": "kami cuma berhasil membuat<br>game yang gila dan indah."
  },
  {
   "dari": 44.957,
   "sampai": 47.457,
   "teks": "Tapi tiap game meninggalkan sesuatu."
  },
  {
   "dari": 47.457,
   "sampai": 52.846,
   "teks": "Dari teknologi game pertama,<br>timnya membuat situs foto, namanya Flickr."
  },
  {
   "dari": 52.846,
   "sampai": 57.4,
   "teks": "Dari alat chat yang tim tambal di atas IRC<br>selama bikin game kedua,"
  },
  {
   "dari": 57.4,
   "sampai": 60.306,
   "teks": "mereka membuat aplikasi kerja,<br>namanya Slack."
  },
  {
   "dari": 60.306,
   "sampai": 62.216,
   "teks": "Dan akhir ceritanya pun berima."
  },
  {
   "dari": 62.216,
   "sampai": 64.44,
   "teks": "Tahun 2005, Yahoo membeli Flickr,"
  },
  {
   "dari": 64.44,
   "sampai": 67.143,
   "teks": "dengan harga yang nggak pernah diumumkan."
  },
  {
   "dari": 67.143,
   "sampai": 70.5,
   "teks": "Tahun 2021, Salesforce membeli Slack,"
  },
  {
   "dari": 70.5,
   "sampai": 74.853,
   "teks": "dengan nilai kesepakatan<br>sekitar 27,7 miliar dolar."
  },
  {
   "dari": 74.853,
   "sampai": 76.58,
   "teks": "Dua kali gamenya gagal,"
  },
  {
   "dari": 76.58,
   "sampai": 80.803,
   "teks": "dan dua kali, alat buatan tim<br>untuk diri sendiri yang menyelamatkan."
  },
  {
   "dari": 80.803,
   "sampai": 85.311,
   "teks": "Jadi produk terbaikmu bisa jadi alat<br>yang kamu buat sambil mengejar hal lain."
  },
  {
   "dari": 85.311,
   "sampai": 88.4,
   "teks": "Alat buatan sendiri apa yang<br>diam-diam menyelamatkan kerjamu?"
  },
  {
   "dari": 88.4,
   "sampai": 89.841,
   "teks": "Tulis di komentar."
  }
 ],
