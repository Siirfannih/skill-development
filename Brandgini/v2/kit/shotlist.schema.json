{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoalnyaGiniShotlist v2",
  "description": "Kontrak skill 02 -> 06 -> 07. Waktu beat = sumber tunggal untuk still storyboard, keyframe QC, dan golden frame (tools/beat_frames.py). Aturan lintas-beat (rapat, <=2,2 dtk per perubahan, variasi transisi, momen tanda_tangan_buka) dicek oleh `beat_frames.py cek`, bukan oleh skema ini.",
  "type": "object",
  "required": ["episode_id", "title", "gaya", "kartu_kiblat", "opening_cap", "target_duration_sec", "fps", "beats"],
  "properties": {
    "episode_id": {"type": "string", "pattern": "^sg[0-9]{3}$"},
    "title": {"type": "string", "maxLength": 70, "description": "target <= 60 karakter (plan §2.4); judul Hari 1 plan sendiri 62 karakter"},
    "gaya": {"enum": ["A-kolase", "B-arsip"]},
    "kartu_kiblat": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"},
      "description": "ID kartu cookbook skill-development (mis. 95, M09). 2-4 kartu per video (MOTION-CORE Langkah 1)."},
    "opening_cap": {"enum": ["Kalau…", "Kenapa…", "Katanya…"]},
    "pilar": {"type": "string", "pattern": "^[A-L]$"},
    "target_duration_sec": {"type": "number", "minimum": 45, "maximum": 60},
    "fps": {"const": 30},
    "beats": {
      "type": "array", "minItems": 10, "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["beat_id", "start_sec", "end_sec", "vo_text", "kt", "visual_type", "metafora", "transisi_masuk", "kamera", "sfx"],
        "properties": {
          "beat_id": {"type": "integer", "minimum": 1},
          "start_sec": {"type": "number", "minimum": 0},
          "end_sec": {"type": "number", "exclusiveMinimum": 0},
          "keyframe_sec": {"type": "number", "description": "frame tahan untuk still/QC; kosong = start + min(max(0,6; 0,55 x durasi); durasi - 0,1)"},
          "perubahan_sec": {"type": "array", "items": {"type": "number"}, "description": "waktu perubahan visual di dalam beat (objek baru, gerak kamera, ganti keadaan)"},
          "vo_text": {"type": "string", "minLength": 1},
          "fakta_ids": {"type": "array", "items": {"type": "string", "pattern": "^F[0-9]{1,2}$"}},
          "kt": {"type": "array", "items": {"type": "object", "required": ["teks", "peran", "kode"],
            "properties": {"teks": {"type": "string"}, "peran": {"enum": ["R1", "R2", "R3", "R4", "R5", "R6", "sub"]},
              "kode": {"type": "string", "pattern": "^T[0-9]{2}$"}, "baris": {"type": "integer", "minimum": 1, "maximum": 2}}}},
          "visual_type": {"enum": ["cap_pembuka", "tanda_tangan_buka", "kolase_hero", "kolase_tukar", "kolase_aksi_kursor",
            "arsip_stabilo", "arsip_polaroid", "arsip_cetakbiru", "arsip_stempel", "arsip_pita", "diagram_rakit",
            "potongan_melintang", "angka_kunci", "payoff_oh_gitu", "loop_tutup"]},
          "metafora": {"type": "object", "required": ["makna", "aksi", "objek"],
            "properties": {"makna": {"type": "string"}, "aksi": {"type": "string"}, "objek": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string"}},
              "bentuk": {"type": "string"}}},
          "aset": {"type": "array", "items": {"type": "string"}, "description": "path relatif ke merek/soalnya-gini/aset/ (maskot, cutout berlisensi); dicek ada"},
          "transisi_masuk": {"type": "object", "required": ["tipe"],
            "properties": {"tipe": {"enum": ["potong", "whip", "push-through", "pull-back", "match-cut", "grid-flash", "invert-flash", "keyhole", "buka-maskot", "drop-in", "slide-arah"]},
              "frames": {"type": "integer", "minimum": 0, "maximum": 20}, "alasan": {"type": "string"}}},
          "kamera": {"type": "string", "description": "gerak kamera yang disengaja tiap shot > 2 dtk (Lantai B10)"},
          "sfx": {"type": "array", "items": {"type": "object", "required": ["t", "file", "pilar"],
            "properties": {"t": {"type": "number"}, "file": {"type": "string"},
              "pilar": {"enum": ["bed", "transisi", "tick", "foley", "aksen"]}}}},
          "maskot": {"type": "object", "required": ["karakter", "aksi", "fungsi"],
            "description": "Slot maskot generik: karakter = kunci di merek/soalnya-gini/aset/maskot/MASKOT.json (kardus Gini, KLIK dari vibedesign cast.js, atau aset lain). aksi = kata kerja, fungsi = apa yang dijelaskan kemunculan ini (vibedesign guide/karakter KRK-01).",
            "properties": {"karakter": {"type": "string"}, "aksi": {"type": "string"}, "fungsi": {"type": "string"},
              "ekspresi": {"type": "string"}, "pose": {"type": "string"}}},
          "golden_ref": {"type": "string"}
        }
      }
    }
  }
}
