{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "ukur-gerak (data ukur otomatis gerak.py, versi 3)",
 "description": "Tanda tangan GERAK satu teknik referensi. Angka dari skrip (gerak.py); model vision hanya mengisi nama_gerak. Tidak memuat warna, huruf, objek, atau tata letak referensi.",
 "type": "object",
 "additionalProperties": false,
 "required": ["versi", "id", "kartu", "teknik", "komponen", "jenis", "sumber", "mekanik", "catatan"],
 "properties": {
  "versi": {"const": 3},
  "id": {"type": "string", "pattern": "^[0-9]+-T[0-9]+$"},
  "kartu": {"type": "string"},
  "teknik": {"type": "string", "pattern": "^T[0-9]+$"},
  "komponen": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$"},
  "jenis": {"enum": ["kt", "kamera", "transisi", "ui"]},
  "nama_gerak": {"type": "array", "items": {"enum": ["satu-kata-per-ketukan", "ketik", "potong-keras", "mask-reveal", "slide", "scale", "fade", "blur", "pegas", "dorong-kamera", "geser-kamera", "orbit", "kamera-berjalan", "grid-piksel", "wipe", "klik", "hold", "tangga-skala"]}},
  "mekanik": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
  "catatan": {"type": "string"},
  "sumber": {
   "type": "object", "additionalProperties": false, "required": ["statis", "fps", "rasio"],
   "properties": {
    "statis": {"type": "boolean"},
    "klip": {"type": "object", "additionalProperties": false, "required": ["path", "dari", "sampai"],
             "properties": {"path": {"type": "string"}, "dari": {"type": "number", "minimum": 0}, "sampai": {"type": "number"}}},
    "keyframe": {"type": "array", "items": {"type": "string"}},
    "fps": {"const": 30},
    "fps_asli": {"type": "number", "exclusiveMinimum": 0},
    "frame_duplikat": {"type": "object", "required": ["frame", "periode", "fps_animasi"]},
    "lebar_analisis": {"type": "integer"},
    "rasio": {"enum": ["16:9", "9:16"]},
    "fokus": {"type": "object", "additionalProperties": false, "required": ["mode", "roi"],
              "properties": {"mode": {"enum": ["latar", "terang", "gelap"]}, "roi": {"oneOf": [{"type": "null"}, {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 4, "maxItems": 4}]}}}
   }
  },
  "durasi_frame": {"type": "integer", "minimum": 3},
  "fokus": {"type": "object", "required": ["muncul_frame", "masuk", "keluar"],
            "properties": {"muncul_frame": {"type": ["integer", "null"]}, "hilang_frame": {"type": ["integer", "null"]},
                           "masuk": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/masuk"}]}, "keluar": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/masuk"}]},
                           "rotasi_maks_derajat": {"type": "number"}}},
  "segmen": {"type": "array", "items": {"$ref": "#/$defs/segmen"}},
  "hold": {"type": "object", "required": ["daftar", "maks_frame"], "properties": {"daftar": {"type": "array"}, "maks_frame": {"type": "integer", "minimum": 0}}},
  "stagger": {"type": "object", "required": ["onset_frame", "interval_rata", "ketidakrataan_cv", "unit"],
              "properties": {"onset_frame": {"type": "array", "items": {"type": "integer"}}, "interval_rata": {"type": ["number", "null"]},
                             "ketidakrataan_cv": {"type": ["number", "null"]}, "unit": {"enum": ["huruf", "kata", "baris", "tunggal", "tidak-ada"]}}},
  "potong": {"type": "array", "items": {"type": "integer"}},
  "transisi": {"type": "array", "items": {"type": "object", "required": ["mulai", "selesai", "durasi_frame", "bentuk"],
               "properties": {"mulai": {"type": "integer"}, "selesai": {"type": "integer"}, "durasi_frame": {"type": "integer"}, "bentuk": {"enum": ["grid", "linear", "seragam"]},
                              "arah": {"type": ["array", "null"]}, "grid": {"type": ["object", "null"]}}}},
  "kamera": {"type": "object", "required": ["skala_total", "geser_x", "geser_y", "n_segmen", "jangkar"]},
  "kurva_sinyal": {"type": "object", "required": ["n", "cx", "cy", "skala", "opasitas", "kamera_s", "kamera_x", "kamera_y", "energi"],
                   "properties": {"n": {"type": "integer", "minimum": 10}}, "additionalProperties": {"type": "array", "items": {"type": "number"}}},
  "plot": {"type": "string"},
  "kurva_baru": {"type": "array", "items": {"type": "object", "required": ["nama", "bezier"], "properties": {"nama": {"type": "string"}, "bezier": {"type": "array", "minItems": 4, "maxItems": 4}}}}
 },
 "if": {"properties": {"sumber": {"properties": {"statis": {"const": false}}}}},
 "then": {"required": ["durasi_frame", "fokus", "segmen", "hold", "stagger", "potong", "transisi", "kamera", "kurva_sinyal", "plot"],
          "properties": {"sumber": {"required": ["klip", "fokus", "lebar_analisis"]}}},
 "else": {"properties": {"sumber": {"required": ["keyframe"]}}},
 "$defs": {
  "masuk": {"type": "object", "additionalProperties": false, "required": ["jenis", "durasi_frame"],
            "properties": {"jenis": {"enum": ["potong", "fade", "blur", "mask-reveal", "scale", "slide", "diam"]}, "durasi_frame": {"type": "integer", "minimum": 0}}},
  "segmen": {"type": "object", "required": ["mulai", "selesai", "durasi_frame", "saluran", "kurva", "spring", "overshoot", "deviasi_linear"],
             "properties": {"mulai": {"type": "integer"}, "selesai": {"type": "integer"}, "durasi_frame": {"type": "integer", "minimum": 1},
                            "saluran": {"enum": ["posisi", "skala", "opasitas", "kamera"]},
                            "kurva": {"type": "object", "required": ["bezier", "rms", "terdekat"], "properties": {"bezier": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}}},
                            "spring": {"type": "object", "required": ["stiffness", "damping", "mass", "rms"]},
                            "overshoot": {"type": "number", "minimum": 0}, "deviasi_linear": {"type": "number", "minimum": 0}}}
 }
}
