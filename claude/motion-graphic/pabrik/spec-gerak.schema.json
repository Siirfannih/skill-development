{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "spec-gerak (primitif gerak atomik, versi 4)",
 "description": "Satu primitif = satu mekanik di satu lapisan. Memuat mekanik, pemicu, alasan bekerja, slot, daftar jangan dicuri, dan parameter berlabel measured/estimated dengan bukti. Kombinasi primitif disimpan sebagai resep (resep/*.json) yang hanya merujuk id. Data ukur otomatis ada di ukur/data (ukur-gerak.schema.json) dan dirujuk lewat bukti.",
 "type": "object",
 "additionalProperties": false,
 "required": ["versi", "id", "kategori", "komponen", "mekanik", "parameter", "pemicu", "alasan_bekerja", "slot", "jangan_dicuri", "sumber", "kemunculan", "uji", "status_maks"],
 "properties": {
  "versi": {"const": 4},
  "id": {"type": "string", "pattern": "^(tipografi|visual|kamera|transisi)-[a-z0-9]+(-[a-z0-9]+)+$", "description": "<lapisan>-<aksi>-<objek-generik>"},
  "kategori": {"enum": ["tipografi", "visual", "kamera", "transisi"]},
  "komponen": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$"},
  "mekanik": {"type": "string", "minLength": 20, "description": "Kalimat gerak tanpa menyebut benda referensi."},
  "parameter": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/angka"}},
  "kurva": {"type": "object", "additionalProperties": false, "required": ["progres_ref", "label", "bukti"],
            "description": "Progres 0..1 terukur per frame asli (satu baris per kemunculan); bezier hasil fit dari data itu.",
            "properties": {"progres_ref": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 3, "items": {"type": "number"}}},
                           "bezier": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
                           "kurva_toolkit": {"type": "string"},
                           "label": {"enum": ["measured", "estimated"]}, "bukti": {"type": "string", "minLength": 5}}},
  "potong": {"type": "array", "items": {"type": "string"}, "description": "Bagian yang berupa cut (lompatan 1 frame): tanpa kurva."},
  "pemicu": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["istilah", "dari_catalog"],
             "properties": {"istilah": {"type": "string"}, "dari_catalog": {"type": "boolean"}, "kartu": {"type": "string"}}}},
  "alasan_bekerja": {"type": "string", "minLength": 20, "description": "Satu kalimat tentang penonton."},
  "slot": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["nama", "isi"],
           "properties": {"nama": {"type": "string"}, "isi": {"type": "string"}}}},
  "jangan_dicuri": {"type": "object", "additionalProperties": false, "required": ["warna", "bentuk", "objek", "teks", "tata_letak"],
                    "properties": {"warna": {"type": "array", "items": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}},
                                   "bentuk": {"type": "array", "items": {"type": "string"}}, "objek": {"type": "array", "items": {"type": "string"}},
                                   "teks": {"type": "array", "items": {"type": "string"}}, "tata_letak": {"type": "array", "items": {"type": "string"}}}},
  "sumber": {"type": "object", "additionalProperties": false, "required": ["video", "fps_asli", "frame_duplikat", "jendela"],
             "properties": {"video": {"type": "string"}, "kartu": {"type": "string"}, "fps_asli": {"type": "number"},
                            "frame_duplikat": {"type": "object", "required": ["frame", "periode", "fps_animasi"]},
                            "jendela": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["dari", "sampai", "isi"],
                                        "properties": {"dari": {"type": "number"}, "sampai": {"type": "number"}, "isi": {"type": "string"}}}},
                            "data_ukur": {"type": "array", "items": {"type": "string"}}, "arsip": {"type": "string"}}},
  "kemunculan": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["video", "detik", "kulit"],
                 "properties": {"video": {"type": "string"}, "detik": {"type": "string"}, "kulit": {"type": "string"}}}},
  "uji": {"type": "object", "required": ["jenis", "demo"],
          "properties": {"jenis": {"enum": ["unit-masuk", "unit-ganti", "kamera-jalan", "skala-lompat", "statis"]},
                         "demo": {"type": "object", "required": ["durasi", "width", "height", "onset"],
                                  "properties": {"durasi": {"type": "integer"}, "width": {"type": "integer"}, "height": {"type": "integer"},
                                                 "onset": {"type": "array", "items": {"type": "integer"}}}}}},
  "status_maks": {"enum": ["teruji", "teruji-sebagian"]},
  "catatan": {"type": "string"}
 },
 "allOf": [
  {"if": {"properties": {"parameter": {"contains": {"properties": {"label": {"const": "estimated"}, "inti": {"const": true}}}}}},
   "then": {"properties": {"status_maks": {"const": "teruji-sebagian"}}}},
  {"if": {"properties": {"kurva": {"properties": {"label": {"const": "estimated"}}}}, "required": ["kurva"]},
   "then": {"properties": {"status_maks": {"const": "teruji-sebagian"}}}}
 ],
 "$defs": {
  "angka": {"type": "object", "additionalProperties": false, "required": ["nama", "nilai", "satuan", "label", "bukti"],
            "properties": {"nama": {"type": "string"}, "nilai": {"type": ["number", "string", "array"]}, "satuan": {"type": "string"},
                           "label": {"enum": ["measured", "estimated"]}, "bukti": {"type": "string", "minLength": 5},
                           "rentang_aman": {"type": "array", "minItems": 2, "maxItems": 2},
                           "inti": {"type": "boolean", "description": "true = parameter inti mekanik; estimated di sini membatasi status ke teruji-sebagian."}}}
 }
}
